PROJECT_NAME="LitePing Engine"
SECRET_KEY="PROVIDE_A_SECURE_RANDOM_HASH_STRING_FOR_JWT_SIGNING"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relational Database Connection (For Local Dev: postgresql+asyncpg://postgres:postgres@localhost:5432/liteping)
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>"

# Caching Layer & Task State (Provide your serverless Upstash Redis URL endpoint here)
REDIS_URL="redis://default:<upstash_password>@<upstash_endpoint_url>:<port>/0"
